# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# ── API auth ──────────────────────────────────────────────────────────────────
API_KEY=change-me-in-production

# ── Model ─────────────────────────────────────────────────────────────────────
# Path is relative to the working directory when you launch uvicorn.
# The default (set in config.py) resolves automatically to
# inference_service/models/inference_model.onnx — only set this if you
# want to override to a different file.
MODEL_PATH=models/inference_model.onnx
CONFIDENCE_THRESHOLD=0.45

# ── Servo tuning ──────────────────────────────────────────────────────────────
PAN_GAIN=0.05
TILT_GAIN=0.05
MAX_PAN_DELTA=15.0
MAX_TILT_DELTA=10.0
PAN_MIN=-90.0
PAN_MAX=90.0
TILT_MIN=-30.0
TILT_MAX=30.0
DEADZONE_PX=20.0
MIN_SERVO_DELTA_DEG=1.5
COMMAND_LATENCY_MS=220.0
MAX_VELOCITY_COMP_PX=150.0

# ── State machine ─────────────────────────────────────────────────────────────
LOST_TRACKING_FRAMES=5
ACTION_DEBOUNCE_FRAMES=10

# ── JEV / OpenRouter (TypeSafe AI) ─────────────────────────────────────────────
OPENROUTER_API_KEY=
JEV_API_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=~typesafe/jev-latest
JEV_TIMEOUT_S=0.8

# ── Logging ───────────────────────────────────────────────────────────────────
# Default (set in config.py) resolves to inference_service/logs/inference.jsonl.
# Only override if you want logs somewhere else.
LOG_FILE_PATH=logs/inference.jsonl
LOG_MAX_LINES=50000
