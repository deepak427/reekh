[Unit]
Description=Wildlife Surveillance Inference Service (AWS Graviton t4g.medium)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/inference_service
EnvironmentFile=-/home/ubuntu/inference_service/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/inference_service/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

LimitNOFILE=65536
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
